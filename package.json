{
  "name": "igem-2026-wiki",
  "private": true,
  "version": "0.1.0",
  "license": "CC-BY-4.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "validate:igem-assets": "node scripts/validate-igem-assets.mjs",
    "validate:igem-content": "node scripts/validate-igem-content.mjs",
    "check:igem-dist": "node scripts/check-igem-dist.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check .",
    "check": "yarn lint && yarn format:check && yarn build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2",
    "typescript": "6.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "10.9.1",
    "eslint-plugin-jsdoc": "64.3.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.69.0"
  }
}
